# 推荐运行 ./trip setup 创建并填写本机 .env；也可手动复制后再编辑。
# .env 已被 .gitignore 忽略，不会被提交。

# ---- LLM ----
# 任意 OpenAI 兼容厂商的 API key
API_KEY=

# ---- 高德地图 ----
# 天气工具 + 地图工具（geocode/路径规划/静态地图）共用此 key
AMAP_API_KEY=

# ---- Exa 搜索 ----
# search_web 工具用，exa.ai 免费注册
EXA_API_KEY=

# ---- 地图工具 ----
# CJK 字体文件路径（总览图渲染中文标签用，不填则不显示中文）
MAP_FONT_PATH=

# ---- 小红书（可选）----
# 仅当 config.toml [xhs].enabled=true 且服务开启 Bearer 认证时才需要
XHS_MCP_TOKEN=

# ---- Web 服务 ----
# REST / WebSocket / 图片接口的 M0 演示口令；公网演示前请生成新的随机值
WEB_TOKEN=

# ---- Cloudflare Named Tunnel（可选，仅固定域名启动）----
# 私人域名只填在本机 .env，不要提交到仓库。
TRIP_DOMAIN=
# 本机 cloudflared Named Tunnel 的 config.yml 绝对路径。
TRIP_TUNNEL_CONFIG=
